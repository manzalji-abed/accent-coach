// Cloudflare Workers deploy config (Next.js via the OpenNext adapter).
// main auto-deploys through Cloudflare Workers Builds; `npm run deploy` does the same by hand.
// Secrets (GEMINI_API_KEY) are set with `npx wrangler secret put`, never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accent-coach",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "accent-coach" }],
  // Only reachable on the custom domain (behind Cloudflare Access), not on a public workers.dev URL.
  "routes": [{ "pattern": "coaccent.abedmanzalji.com", "custom_domain": true }],
  "workers_dev": false,
  // Preview URLs would be public *.workers.dev links that share GEMINI_API_KEY. Keep them off
  // unless Cloudflare Access is enabled for preview URLs in the Worker's settings first.
  "preview_urls": false,
  // PR branches on Cloudflare run `wrangler preview` (Worker Previews). A preview only gets
  // the bindings listed here, never production secrets, and MOCK_AI forces demo mode so a
  // preview can never call Gemini or spend the key.
  "previews": { "vars": { "MOCK_AI": "1" } },
  "observability": { "enabled": true }
}
